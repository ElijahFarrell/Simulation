# Copy to .env.local. Every value here is a placeholder. Do not put real keys in git.

# Clerk. The publishable key is public; the secret key stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# From `npx convex dev`. This URL is public. The Convex deploy key is not an app env var.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Epic Account Services client id. The matching secret is set on Convex, not here.
EPIC_CLIENT_ID=your_epic_client_id

# Optional AI coach. Leave the passcode empty to keep /api/coach off.
COACH_PASSCODE=your_coach_passcode
AI_GATEWAY_API_KEY=your_ai_gateway_key

# Set these on the Convex deployment with `npx convex env set`, not in .env.local:
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# EPIC_CLIENT_ID=your_epic_client_id
# EPIC_CLIENT_SECRET=your_epic_client_secret
# EPIC_DEPLOYMENT_ID=your_epic_deployment_id
